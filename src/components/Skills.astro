---
const skills = [
  {
    title: "Coding",
    description:
      "I use Rust for most of my projects, Java for Paper plugins, and C++ for Competitive Programming!"
  },
  {
    title: "BGP",
    description:
      "Though I don't have an ASN in clearnet, I am a DN42 player. My DN42 ASN is AS4242423942, welcome to peer with me!",
    linkUrl: "https://cat.dn42",
    linkLabel: "cat.dn42",
    linkPrefix: "BTW, you can view this page on ",
    linkSuffix: " (accessible inside DN42 network)"
  },
  {
    title: "Linux",
    description:
      "I use Linux on my main computer, BTW! And some of my server is running Debian GNU/Linux. I hope to dive deeper into Linux in the future."
  },
  {
    title: "Something else...?",
    description:
      "I like to try and challenge something I've never tried before, maybe I'm working on something new at this time?"
  }
];
---

<section id="skills" class="skills">
  <div class="container">
    <h2>What I Do</h2>
    <ul class="skills-list">
      {skills.map((skill) => (
        <li class="skill-item">
          <h3>{skill.title}</h3>
          <p>
            {skill.description}
            {skill.linkUrl && (
              <>
                {" "}
                {skill.linkPrefix}
                <a href={skill.linkUrl} target="_blank" rel="noopener noreferrer">
                  {skill.linkLabel}
                </a>
                {skill.linkSuffix}
              </>
            )}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .skills {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    font-weight: 600;
  }

  .skills-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .skill-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .skill-item:last-child {
    border-bottom: none;
  }

  .skill-item h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
    color: var(--text);
  }

  .skill-item p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .skills {
      padding: 3rem 0;
    }

    .container {
      padding: 0 1.5rem;
    }

    h2 {
      font-size: 1.75rem;
    }

    .skills-list {
      gap: 1.25rem;
    }

    .skill-item {
      padding: 1rem 0;
    }
  }
</style>
