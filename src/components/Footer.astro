---
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="container">
    <p>
        &copy; {currentYear} Maoyue. Content licensed under 
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer">CC BY-SA 4.0</a>. 
        This website is 
        <a href="https://git.maoyue.tw/Maoyue/maoyue.tw.git" target="_blank" rel="noopener noreferrer">free software</a>,
        licensed under the
        <a href="https://www.gnu.org/licenses/" target="_blank" rel="noopener noreferrer">GNU GPL-3.0-or-later</a>
        and built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>.
    </p>
  </div>
</footer>

<style>
  footer {
    padding: 3rem 0 2rem;
    border-top: 1px solid var(--border, #e5e7eb);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
    text-align: center;
  }

  p {
    color: var(--text-muted, #4b5563);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    footer {
      padding: 2rem 0 1.5rem;
    }

    .container {
      padding: 0 1.5rem;
    }
  }
</style>
