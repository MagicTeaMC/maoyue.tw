---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpeg,jpg,png,gif,webp}');

const imageList = await Promise.all(
  Object.entries(images).map(async ([path, image]) => {
    const img = await image();
    const optimized = await getImage({ src: img.default });
    const filename = path.split('/').pop()?.split('.')[0] || 'Gallery image';
    return { src: optimized.src, alt: filename, filename };
  })
);

imageList.sort((a, b) => {
  const numA = parseInt(a.filename.match(/\d+/)?.[0] || '0');
  const numB = parseInt(b.filename.match(/\d+/)?.[0] || '0');
  return numB - numA;
});

const galleryHtml = imageList.map(({ src, alt }) =>
  `<a class="gallery-item" href="${src}" target="_blank" rel="noopener" aria-label="${alt}">` +
  `<img src="${src}" alt="${alt}" loading="lazy" />` +
  `</a>`
).join('');
---

<Layout title="Gallery - Maoyue">
  <Header />

  <main class="gallery-page">
    <div class="container">
      <h1>Gallery</h1>

      {imageList.length === 0 && <div class="empty-state"></div>}

      {imageList.length > 0 && (
        <div class="gallery-grid" set:html={galleryHtml} />
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .gallery-page {
    min-height: calc(100vh - 200px);
    padding: 4rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  :global(.gallery-item) {
    display: block;
    overflow: hidden;
    border-radius: 8px;
    background: var(--border);
    aspect-ratio: 1;
    transition: transform 0.3s ease;
  }

  :global(.gallery-item:hover) {
    transform: scale(1.02);
  }

  :global(.gallery-item img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .gallery-page {
      padding: 2rem 0;
    }

    h1 {
      font-size: 2rem;
    }

    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 1rem;
    }

    .container {
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>