---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="GPG Key - Maoyue" description="Maoyue's GPG public key and fingerprint">
  <Header />
  <main class="gpg-page">
    <div class="container">
      <h1>GPG Key</h1>
      <p class="subtitle">Use this key to send me encrypted messages or verify my signatures.</p>

      <section class="card">
        <div class="card-header">
          <span class="label">Fingerprint</span>
        </div>
        <pre class="fingerprint"><code>pub   ed25519 2026-04-19 [SC]
      B9AE 362B F898 1D7C 617A  7CD4 01DA 5E6E 1222 A680
uid           [ultimate] Maoyue &lt;maoyuetw@proton.me&gt;
sub   cv25519 2026-04-19 [E]</code></pre>
      </section>

      <section class="trust-warning" role="alert" aria-label="Security notice">
        <div class="trust-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <div class="trust-content">
          <p class="trust-title">Verify you're on the right site</p>
          <p class="trust-body">
            <strong>Only trust this key if you fetched it directly from
            https://maoyue.tw/gpg.</strong>
            Before importing, confirm your browser shows a valid HTTPS padlock and the
            URL begins with <code>https://</code>, not <code>http://</code>.
            If you received this key via email, a third-party mirror, or any other
            channel, verify the fingerprint independently before trusting it.
          </p>
          <p class="trust-body">
            <strong>Do not import this key from any public key server.</strong>
            Keys on those servers can be uploaded by <em>anyone</em>, meaning a malicious
            actor could publish a forged key under this identity with no verification
            whatsoever.
          </p>
        </div>
      </section>

      <section class="actions">
        <a href="/pubkey.txt" class="btn btn-primary" download>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          Download Public Key
        </a>
        <a href="/pubkey.txt" class="btn btn-secondary" target="_blank" rel="noopener">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          View Raw
        </a>
      </section>

      <section class="usage">
        <h2>Usage</h2>
        <div class="code-block">
          <span class="code-label">Import from URL</span>
          <pre><code>curl https://maoyue.tw/pubkey.txt | gpg --import</code></pre>
        </div>
        <div class="code-block">
          <span class="code-label">Encrypt a file</span>
          <pre><code>gpg --encrypt --recipient maoyuetw@proton.me secret.txt</code></pre>
        </div>
        <div class="code-block">
          <span class="code-label">Verify a signature</span>
          <pre><code>gpg --verify file.sig file</code></pre>
        </div>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .gpg-page {
    min-height: calc(100vh - 120px);
    padding: 4rem 1.5rem;
  }

  .container {
    max-width: 680px;
    margin: 0 auto;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .card-header {
    display: flex;
    align-items: center;
    padding: 0.6rem 1rem;
    background: #222;
    border-bottom: 1px solid var(--border);
  }

  .label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .fingerprint {
    margin: 0;
    padding: 1.25rem 1rem;
    background: #111;
    overflow-x: auto;
  }

  .fingerprint code {
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.82rem;
    line-height: 1.7;
    color: #c9d1d9;
  }

  .trust-warning {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border: 1px solid #2a3a2a;
    border-radius: 8px;
    background: #0f1f0f;
    margin-bottom: 1.5rem;
  }

  .trust-icon {
    flex-shrink: 0;
    margin-top: 0.1rem;
    color: #4ade80;
  }

  .trust-content {
    flex: 1;
    min-width: 0;
  }

  .trust-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #4ade80;
    margin: 0 0 0.4rem;
  }

  .trust-body {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.65;
    margin: 0;
  }

  .trust-body + .trust-body {
    margin-top: 0.6rem;
  }

  .trust-body strong {
    color: var(--text);
    font-weight: 500;
  }

  .trust-body code {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.78rem;
    background: #1a2a1a;
    padding: 0.1em 0.35em;
    border-radius: 3px;
    color: #86efac;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    transition: opacity 0.15s, background 0.15s;
  }

  .btn-primary {
    background: var(--accent);
    color: #111;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #111;
  }

  .btn-secondary {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text);
  }

  .btn-secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .usage h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .code-block {
    margin-bottom: 0.75rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }

  .code-label {
    display: block;
    padding: 0.4rem 0.85rem;
    background: #222;
    font-size: 0.72rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
    letter-spacing: 0.05em;
  }

  .code-block pre {
    margin: 0;
    padding: 0.75rem 0.85rem;
    background: #111;
    overflow-x: auto;
  }

  .code-block code {
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 0.82rem;
    color: var(--accent);
  }
</style>