---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    title: "yue.lat",
    description: "A simple and fast URL shortener service. Shorten your long URLs into concise links that are easy to share and remember.",
    url: "https://yue.lat"
  },
  {
    title: "Git (Forgejo)",
    description: "I host my project on my own platform.",
    url: "https://git.maoyue.tw"
  },
  {
    title: "SearXNG instance",
    description: "SearXNG is a privacy-respecting, open metasearch engine, I host a instance for personal usage.",
    url: "https://search.maoyue.tw"
  },
  {
    title: "Piped instance",
    description: "Piped is an alternative privacy-friendly YouTube frontend, I host a instance for personal usage.",
    url: "https://piped.maoyue.tw"
  },
  {
    title: "Mozhi",
    description: "Mozhi is an alternative frontend for many translation engines.",
    url: "https://translate.maoyue.tw/"
  },
  {
    title: "MilkteaMC (Traditional Chinese)",
    description: "A small Minecraft server with custom plugins and special gameplays. Join our community and explore unique features!",
    url: "https://www.milkteamc.org"
  },
];
---

<Layout title="Online Services - Maoyue">
  <Header />
  <main>
    <section class="services">
      <div class="container">
        <h2>Online Services</h2>
        <ul class="services-list">
          {services.map((service) => (
            <li class="service-item">
              <h3>
                <a href={service.url} target="_blank" rel="noopener noreferrer">
                  {service.title}
                </a>
              </h3>
              <p>{service.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .services {
    padding: 4rem 0;
    min-height: calc(100vh - 200px);
    border-top: 1px solid var(--border);
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    font-weight: 600;
  }

  .services-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .service-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  .service-item:last-child {
    border-bottom: none;
  }

  .service-item h3 {
    font-size: 1.125rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .service-item h3 a {
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .service-item h3 a:hover {
    color: var(--accent-hover);
  }

  .service-item p {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 640px) {
    .services {
      padding: 3rem 0;
    }

    .container {
      padding: 0 1.5rem;
    }

    h2 {
      font-size: 1.75rem;
    }

    .services-list {
      gap: 1.25rem;
    }

    .service-item {
      padding: 1rem 0;
    }
  }
</style>